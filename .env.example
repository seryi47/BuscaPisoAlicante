# Copia a .env y rellena. (.env está en .gitignore, nunca se sube a GitHub.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Relé de Idealista (opcional) ---
# Idealista bloquea el scraping de verdad; esta es la vía legítima: una
# alerta de búsqueda guardada que Idealista manda por email, leída por IMAP.
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de 16 caracteres
# (myaccount.google.com/apppasswords, requiere verificación en 2 pasos
# activada), NUNCA tu contraseña normal de Google.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
